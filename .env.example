# ============================================
# VECTRA FUTURELAB
# ============================================
FUTURELAB_ENV=development
LOG_LEVEL=INFO
TZ=America/Los_Angeles
FUTURELAB_ENABLED=true

# API
FUTURELAB_API_HOST=127.0.0.1
FUTURELAB_API_PORT=8787
FUTURELAB_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Storage
FUTURELAB_DATABASE_URL=sqlite:///data/futurelab.db
FUTURELAB_OUTPUT_DIR=outputs/futurelab

# ============================================
# SHAREDROUTE (OpenAI-compatible)
# ============================================
# All LLM traffic goes through SharedRoute. Physical oMLX nodes, Ollama hosts,
# and physical model names are never configured here.
# Routing uses X-Route-Project + X-Route-Task (SharedRoute owns FAST/MEDIUM/HEAVY).
OPENAI_BASE_URL=http://10.0.0.27:8088/v1
OPENAI_API_KEY=unused
AI_MODEL=router
AI_PROJECT=VectraFutureLab
LLM_TEMPERATURE=0.45
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ============================================
# COST & AUTONOMY LIMITS
# ============================================
MAX_RUNTIME_MINUTES=90
MAX_MODEL_CALLS=80
MAX_TOKENS=250000
MAX_RESEARCH_QUERIES=24
MAX_PROTOTYPE_COST_USD=0.0
MAX_PARALLEL_AGENTS=4
PROTOTYPE_THRESHOLD=80
AUTO_PROTOTYPE=false
REQUIRE_HUMAN_APPROVAL_FOR_BUILD=true
# Nightly builds this many prototypes → this many new GitHub repos (with --build + GITHUB_AUTO_PUBLISH)
DAILY_PROTOTYPE_COUNT=2

# Scoring bands
SCORE_ARCHIVE_BELOW=60
SCORE_INTERESTING_BELOW=70
SCORE_WATCH_BELOW=80
SCORE_PROTOTYPE_BELOW=90

# Memory
DUPLICATE_SIMILARITY_THRESHOLD=0.78
RESURRECTION_MIN_DELTA=8

# ============================================
# RESEARCH
# ============================================
GITHUB_TOKEN=
# Opt-in: create a NEW GitHub repo and push each built prototype (isolated dir only)
GITHUB_AUTO_PUBLISH=false
GITHUB_OWNER=
GITHUB_OWNER_IS_ORG=false
GITHUB_PRIVATE=false
# Optional PascalCase prefix for new repo names (empty = use product name only)
GITHUB_REPO_PREFIX=
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Domain scope — FutureLab invents AI + Agentic AI only
REQUIRE_AI_AGENTIC_SCOPE=true
DEFAULT_THEME=Autonomous AI Agents

# ============================================
# HERMES / WHATSAPP (reuse existing integration)
# ============================================
HERMES_ENABLED=false
HERMES_COMMAND=hermes
HERMES_WHATSAPP_GROUP=
FUTURELAB_SEND_WHATSAPP=false
